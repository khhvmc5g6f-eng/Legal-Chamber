{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://legal-chambers/schemas/prospect.schema.json",
  "title": "Prospect",
  "description": "Prospects-of-success assessment. Dimensions are shown separately, never mechanically averaged into one number.",
  "type": "object",
  "required": ["matter_id", "dimensions", "overall_descriptor"],
  "properties": {
    "matter_id": { "type": "string" },
    "dimensions": {
      "type": "object",
      "properties": {
        "law": { "type": "string" },
        "facts": { "type": "string" },
        "evidence": { "type": "string" },
        "procedure": { "type": "string" },
        "credibility": { "type": "string" },
        "causation": { "type": "string" },
        "remedy": { "type": "string" },
        "discretion": { "type": "string" },
        "appellate_uncertainty": { "type": "string" }
      }
    },
    "overall_descriptor": { "type": "string", "enum": ["VERY_STRONG", "STRONG", "REASONABLE", "BALANCED", "WEAK", "VERY_WEAK"] },
    "best_realistic_case": { "type": "string" },
    "central_case": { "type": "string" },
    "worst_realistic_case": { "type": "string" },
    "sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "if_fact": { "type": "string" },
          "effect": { "type": "string" }
        }
      }
    },
    "uncertainty_budget": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Sources of accumulated uncertainty - factual gaps, legal uncertainty, authority conflict, evidential gaps, procedural ambiguity."
    }
  }
}
